library(brglm2)
library(emmeans)
library(multcomp)
library(multcompView)

mod_fuego <- glm(cbind(exito, fracaso) ~ carga * especie, family = binomial,
                 data = germ0, method = brglmFit,
                 type = "AS_mean")
plot(mod_fuego)





summary(mod_fuego)

anova(mod_fuego, test = "Chisq")




emm_fuego <- emmeans(mod_fuego, ~ carga | especie, type = "response")

cld_fuego <- cld(emm_fuego,Letters = letters, adjust = "tukey")

