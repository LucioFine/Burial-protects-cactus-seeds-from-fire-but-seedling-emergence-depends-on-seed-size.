###############################################################
# 2. Preparar datos
###############################################################
library(dplyr)
library(tidyverse)

df <- df %>% mutate(especie = factor(especie),carga = factor(carga,levels = c("control", "C25", "C100")),
    profundidad = factor(profundidad, levels = c("2mm", "5mm")))


###############################################################
# 3. Seleccionar únicamente emergencia
###############################################################


emerg <- subset(df,tipo == "emergencia")


###############################################################
# 4. Resumen descriptivo
###############################################################


resumen_emerg <- emerg %>%group_by(especie, carga, profundidad) %>%
  summarise(emergidas = sum(exito),total = sum(exito + fracaso),
    proporcion = emergidas/total,.groups = "drop")

resumen_emerg


###############################################################
# 5. Modelo binomial
###############################################################


mod_emerg <- glm(cbind(exito, fracaso) ~ especie * carga * profundidad,
  family = binomial,data = emerg, method = brglmFit,
  type = "AS_mean")

plot(mod_emerg)

###############################################################
# 6. Tabla ANOVA
###############################################################

anova(mod_emerg, test = "Chisq")










#la interacción triple no es significativa. 
#Eso sugiere que el patrón general de respuesta a profundidad y carga es 
#relativamente consistente entre especies.

#especie × profundidad  p < 0.0001
#las especies responde de forma diferente a la profundidad

#carga × profundidad p = 0.0008
#Esto indica que el efecto de la carga de combustible depende de la profundidad

