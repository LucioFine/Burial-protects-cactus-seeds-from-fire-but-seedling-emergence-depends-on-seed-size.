#==========================================================
#2. Efecto protector del enterramiento 
#==========================================================

#¿La profundidad reduce los efectos negativos del fuego?

germ_fuego <- subset(df,tipo == "germinacion")

mod_prof <- glm(cbind(exito, fracaso) ~ especie * carga * profundidad,
  family = binomial,data = germ_fuego, method = brglmFit,
  type = "AS_mean")

anova(mod_prof, test = "Chisq")

emm_prof <- emmeans(mod_prof, ~ profundidad | especie * carga,type = "response")

cld_prof <- cld(emm_prof, Letters = letters,adjust = "tukey")

cld_prof



#No debería interpretar los efectos principales (especie, carga, profundidad) de manera aislada.
#Porque una interacción triple significativa significa que:
#El efecto de la profundidad depende de la carga de combustible y esa dependencia cambia entre especies.

# La germinación aumenta progresivamente con la profundidad.El enterramiento mejora fuertemente la germinación.
# Parece necesitar mayor enterramiento para obtener protección.
# El beneficio aparece ya a 2 mm
# 


###################################
#Suepuestos del modelo
###################################

library(DHARMa)

sim_prof <- simulateResiduals(  fittedModel = mod_prof,
                                 n = 1000) # aumento el n para que haga más simulaciones
plot(sim_prof)

testUniformity(sim_prof)

testDispersion(sim_prof)

testOutliers(sim_prof)


