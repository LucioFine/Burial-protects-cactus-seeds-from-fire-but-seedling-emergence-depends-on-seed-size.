# =========================================================
# ANÁLISIS DE LOS TIEMPOS MEDIOS DE GERMINACIÓN (TMG)
# Y EMERGENCIA (TME)
#
# Objetivo:
# Evaluar el efecto de la carga de combustible,
# la profundidad de enterramiento y la especie
# sobre el tiempo medio de germinación y emergencia.
#
# =========================================================

# =========================================================
# PAQUETES
# =========================================================

packages.needed <- c(
  "readxl",
  "dplyr",
  "emmeans",
  "multcomp",
  "multcompView",
  "ggplot2"
)

# Instalar únicamente los paquetes que no estén disponibles
to_install <- packages.needed[
  !(packages.needed %in% installed.packages()[, "Package"])
]

if(length(to_install) > 0){
  install.packages(to_install)
}

# Cargar todos los paquetes necesarios
invisible(
  lapply( packages.needed, library, character.only = TRUE))


# =========================================================
# IMPORTACIÓN Y PREPARACIÓN DE LOS DATOS
# =========================================================

# Importar la base de datos con los tiempos medios de
# germinación (TMG) y emergencia (TME).

datos_TM <- read_excel(
  "D:/Usuario/Usuario/Desktop/UNC/tesina/cacti/datos/TM_GyE.xlsx"
)

# Asegurar que la variable respuesta sea numérica.

datos_TM$TM <- as.numeric(datos_TM$TM)

# Preparar la base de datos para el análisis:
# - eliminar registros sin tiempo medio;
# - definir las variables categóricas como factores;
# - establecer el orden de los niveles de carga y profundidad.

datos_TM <- datos_TM %>%  filter(!is.na(TM)) %>% mutate( especie = factor(especie),
    tipo = factor(tipo),  carga = factor( carga,
      levels = c("control", "C25", "C100") ),
    profundidad = factor( profundidad,
      levels = c("0mm", "2mm", "5mm") ) )




# =========================================================
# TIEMPO MEDIO DE GERMINACIÓN (TMG)
# =========================================================
#
# Objetivo:
# Evaluar si la carga de combustible, la profundidad de
# enterramiento y la especie afectan el tiempo medio de
# germinación de las semillas.



# Seleccionar únicamente los registros correspondientes
# al tiempo medio de germinación.
# se dejan de lado los datos con menos de 20% de germinación

datos_TMG <- datos_TM %>%
  filter(tipo == "Germinación",
         porcentaje >= 20)


# ---------------------------------------------------------
# EFECTO DEL FUEGO
# ---------------------------------------------------------
#
# Se analizan únicamente los tratamientos ubicados en la
# superficie del suelo (0 mm), donde la única variable
# experimental es la carga de combustible.


#datos_TMG_fuego <- datos_TMG %>%  filter(profundidad == "0mm")
datos_TMG_fuego <- datos_TMG 

# Ajustar dos modelos lineales generalizados con diferentes
# distribuciones (Normal y Gamma) para determinar cuál
# representa mejor la distribución de los tiempos medios.


#mod_norm_TMG_fuego <- glm(  TM ~ especie * carga, family = gaussian(),
#  data = datos_TMG_fuego)

mod_gamma_TMG_fuego <- glm( TM ~ especie * carga, family = Gamma (link = "log"),
  data = datos_TMG_fuego)



# Comparar ambos modelos mediante el criterio de información
# de Akaike (AIC). El modelo con menor AIC se utiliza para
# el resto del análisis.

#AIC(mod_norm_TMG_fuego, mod_gamma_TMG_fuego)

#anova(mod_norm_TMG_fuego, mod_gamma_TMG_fuego)



# Resumen del modelo seleccionado.

summary(mod_gamma_TMG_fuego)

# Evaluar los efectos de la especie, la carga de combustible
# y su interacción sobre el tiempo medio de germinación.

anova(mod_gamma_TMG_fuego)


# Estimar las medias marginales ajustadas para cada nivel
# de carga dentro de cada especie.

emm_TMG_fuego_carga <- emmeans( mod_gamma_TMG_fuego,
  ~ carga | especie,  type = "response")

# Comparaciones múltiples entre cargas.

pairs(emm_TMG_fuego_carga)

# Asignación de letras para representar grupos
# estadísticamente diferentes.

cld(emm_TMG_fuego_carga,  Letters = letters)


#=========================================
# Diagnóstico del modelo Gamma (DHARMa)
#=========================================

library(DHARMa)

res_TMG_fuego <- simulateResiduals(
  fittedModel = mod_gamma_TMG_fuego,
  n = 1000
)

plot(res_TMG_fuego)
#QQ-plot de los residuos simulados
#Compara contra una distribución uniforme, que es la esperada si el modelo ajusta correctamente.
#Si los puntos siguen la línea, el ajuste es adecuado.
#Si aparecen desviaciones importantes, el modelo podría estar mal especificado.

#Residuos vs. valores predichos
#Es similar al gráfico clásico.
#Lo que buscás es que los puntos estén distribuidos al azar.


testUniformity(res_TMG_fuego) #los residuos siguen una distribución uniforme.
testDispersion(res_TMG_fuego) #Evalúa si la variabilidad observada coincide con la esperada.
testOutliers(res_TMG_fuego) #Busca más valores extremos de los esperados bajo el modelo.



# ---------------------------------------------------------
#EFECTO DEL ENTERRAMIENTO
# ---------------------------------------------------------
#
# Se analizan únicamente los tratamientos con aplicación
# de combustible y semillas enterradas, con el objetivo
# de evaluar el efecto de la carga de combustible, la
# profundidad de enterramiento y su interacción sobre el
# tiempo medio de germinación.


# Seleccionar únicamente tratamientos con aplicación de
# combustible y semillas enterradas.

datos_TMG_enterramiento <- datos_TMG %>%
  filter(carga != "control",  profundidad != "0mm")



# Ajustar modelos con distribución Normal y Gamma para
# determinar cuál representa mejor la distribución de los
# tiempos medios de germinación.

#mod_norm_TMG_enterramiento <- glm(  TM ~ especie * carga * profundidad,
#  family = gaussian(),  data = datos_TMG_enterramiento)

mod_gamma_TMG_enterramiento <- glm(  TM ~ especie * carga * profundidad,
  family = Gamma(link = "log"),  data = datos_TMG_enterramiento)



# Comparar ambos modelos mediante AIC.
# El modelo con menor AIC será utilizado para el resto
# del análisis.

#AIC( mod_norm_TMG_enterramiento, mod_gamma_TMG_enterramiento)

#anova(mod_norm_TMG_enterramiento, mod_gamma_TMG_enterramiento)



# Resumen del modelo seleccionado.

summary(mod_gamma_TMG_enterramiento)

# Evaluar los efectos principales y las interacciones
# entre especie, carga y profundidad.

anova(mod_gamma_TMG_enterramiento)


# Debido a la interacción especie × profundidad observada
# en el modelo, se comparan las profundidades dentro de
# cada especie mediante medias marginales estimadas.

emm_TMG_ent_profundidad <- emmeans( mod_gamma_TMG_enterramiento,
  ~ profundidad | especie,  type = "response")

pairs(emm_TMG_ent_profundidad)

cld( emm_TMG_ent_profundidad,  Letters = letters)


# Comparar las cargas de combustible dentro de cada
# combinación de especie y profundidad.

emm_TMG_ent_carga <- emmeans( mod_gamma_TMG_enterramiento,~ carga | especie * profundidad,
  type = "response")

pairs(emm_TMG_ent_carga)

cld(emm_TMG_ent_carga,Letters = letters)


#=========================================
# Diagnóstico del modelo Gamma (DHARMa)
#=========================================

res_TMG_ent <- simulateResiduals(
  fittedModel = mod_gamma_TMG_enterramiento,
  n = 1000
)

plot(res_TMG_ent)
testUniformity(res_TMG_fuego) #los residuos siguen una distribución uniforme.
testDispersion(res_TMG_fuego) #Evalúa si la variabilidad observada coincide con la esperada.
testOutliers(res_TMG_fuego) #Busca más valores extremos de los esperados bajo el modelo.

#corregir nombre




# =========================================================
# TIEMPO MEDIO DE EMERGENCIA (TME)
# =========================================================
#
# Objetivo:
# Evaluar si la carga de combustible, la profundidad de
# enterramiento y la especie afectan el tiempo medio de
# emergencia de las plántulas.
#
# A diferencia del análisis del TMG, no es posible evaluar
# el efecto del fuego de manera independiente debido a la
# ausencia de emergencias en los tratamientos superficiales.
# Por lo tanto, el análisis se realiza utilizando todos los
# tratamientos en los que ocurrió emergencia.



# Seleccionar únicamente los registros correspondientes
# al tiempo medio de emergencia.

datos_TME <- datos_TM %>% filter(tipo == "Emergencia", porcentaje > 20)


# Ajustar modelos con distribución Normal y Gamma para
# identificar cuál describe mejor la distribución de los
# tiempos medios de emergencia.

#mod_norm_TME <- glm(TM ~ especie * carga * profundidad, family = gaussian(),  
#  data = datos_TME)

mod_gamma_TME <- glm( TM ~ especie * carga * profundidad, family = Gamma(link = "log"),
  data = datos_TME)



# Comparar ambos modelos mediante el criterio de
# información de Akaike (AIC). El modelo con menor AIC
# se utiliza para el resto del análisis.

#AIC(mod_norm_TME, mod_gamma_TME)


# Resumen del modelo seleccionado.

summary(mod_gamma_TME)


# Evaluar los efectos principales y las interacciones
# entre especie, carga de combustible y profundidad.

anova(mod_gamma_TME)


# Comparar las combinaciones de carga de combustible y
# profundidad dentro de cada especie mediante medias
# marginales estimadas.

emm_TME_tratamientos <- emmeans(  mod_gamma_TME,
  ~ carga * profundidad | especie,  type = "response")

pairs(emm_TME_tratamientos)

cld(  emm_TME_tratamientos, Letters = letters)



# Comparar las especies dentro de cada profundidad de
# enterramiento.

emm_TME_especies <- emmeans(mod_gamma_TME,  ~ especie | profundidad,type = "response")

pairs(emm_TME_especies)

cld(emm_TME_especies, Letters = letters, adjust = "tukey")



#=========================================
# Diagnóstico del modelo Gamma (DHARMa)
#=========================================

res_TME <- simulateResiduals(
  fittedModel = mod_gamma_TME,
  n = 1000
)

plot(res_TME)

testUniformity(res_TME)
testDispersion(res_TME)
testOutliers(res_TME)



