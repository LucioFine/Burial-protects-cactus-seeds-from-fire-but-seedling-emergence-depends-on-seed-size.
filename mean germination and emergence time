#Modelo alternativo para analizar el TMG. Basicamente el modelo utiliza  
# tratamiento como unico factor (en lugar de ver los factores carga, profundidad y especie separados)
 

mod_trat_G <- glm(TM ~ especie * tratamiento, family = Gamma(link = "log"),
  data = datos_TMG)

emm_trat_G <- emmeans(mod_trat_G, ~ tratamiento | especie, type = "response")


pairs(emm_trat_G)

cld(emm_trat_G, Letters = letters, adjust = "tukey")




mod_trat_E <- glm(TM ~ especie * tratamiento, family = Gamma(link = "log"), data = 
                    datos_TME)

emm_trat_E <- emmeans(mod_trat_E, ~ tratamiento | especie, type = "response")

pairs(emm_trat_E)

cld(emm_trat_E, Letters = letters, adjust = "tukey")


# =========================================================
# LETRAS DE SIGNIFICANCIA
# =========================================================

# Obtener las letras a partir de las comparaciones múltiples
# realizadas con emmeans para TMG y TME.

letras_TMG <- cld(
  emm_trat_G,
  Letters = letters
) %>%
  as.data.frame() %>%
  dplyr::select(especie, tratamiento, .group) %>%
  mutate(.group = stringr::str_trim(.group))


letras_TME <- cld(
  emm_trat_E,
  Letters = letters
) %>%
  as.data.frame() %>%
  dplyr::select(especie, tratamiento, .group) %>%
  mutate(.group = stringr::str_trim(.group))



# =========================================================
# PREPARACIÓN DE LOS DATOS PARA EL GRÁFICO
# =========================================================


# ---------------------------------------------------------
# TMG
# ---------------------------------------------------------

# Se calculan las medias y errores estándar descriptivos
# para cada combinación de especie y tratamiento.
# Luego se incorporan las letras obtenidas del modelo.

datos_grafico_TMG <- datos_TMG %>%
  
  mutate(
    tratamiento = factor(
      tratamiento,
      levels = orden_tratamientos
    ),
    especie = factor(
      especie,
      levels = orden_especies
    )
  ) %>%
  
  group_by(
    especie,
    tratamiento
  ) %>%
  
  summarise(
    media = mean(TM),
    se = sd(TM) / sqrt(n()),
    .groups = "drop"
  ) %>%
  
  left_join(
    letras_TMG,
    by = c("especie", "tratamiento")
  ) %>%
  
  mutate(
    tipo = "TMG"
  )


# =========================================================
# PREPARACIÓN DE LOS DATOS PARA EL GRÁFICO
# =========================================================


# ---------------------------------------------------------
# ORDEN DE LOS TRATAMIENTOS EN EL GRÁFICO
# ---------------------------------------------------------

# El control siempre aparece primero.
# Luego se ordenan los tratamientos por carga y profundidad.


orden_tratamientos_grafico <- c(
  "control",
  
  "control 2mm E",
  "control 5mm E",
  
  "C25 0mm G",
  "C100 0mm G",
  
  "C25 2mm G",
  "C25 2mm E",
  "C100 2mm G",
  "C100 2mm E",
  
  "C25 5mm G",
  "C25 5mm E",
  "C100 5mm G",
  "C100 5mm E"
)

# =========================================================
# TMG
# =========================================================

datos_grafico_TMG <- datos_TMG %>%
  
  mutate(
    
    # Convertir a carácter antes de cambiar el nombre
    # del tratamiento control
    
    tratamiento = as.character(tratamiento),
    
    tratamiento = dplyr::recode(
      tratamiento,
      "control 0mm G" = "control"
    ),
    
    especie = factor(
      especie,
      levels = orden_especies
    )
  ) %>%
  
  group_by(
    especie,
    tratamiento
  ) %>%
  
  summarise(
    media = mean(TM),
    se = sd(TM) / sqrt(n()),
    .groups = "drop"
  )


# ---------------------------------------------------------
# PREPARAR LAS LETRAS DEL TMG
# ---------------------------------------------------------

letras_TMG_grafico <- letras_TMG %>%
  
  mutate(
    tratamiento = as.character(tratamiento),
    
    tratamiento = dplyr::recode(
      tratamiento,
      "control 0mm G" = "control"
    )
  )


# ---------------------------------------------------------
# UNIR LAS LETRAS AL TMG
# ---------------------------------------------------------

datos_grafico_TMG <- datos_grafico_TMG %>%
  
  left_join(
    letras_TMG_grafico,
    by = c("especie", "tratamiento")
  ) %>%
  
  mutate(
    tipo = "TMG",
    
    tratamiento = factor(
      tratamiento,
      levels = orden_tratamientos_grafico
    )
  )

# =========================================================
# TME
# =========================================================

# Incorporar el control superficial proveniente de TMG
# como referencia biológica en el panel de TME.

control_base <- datos_TMG %>%
  
  filter(
    tratamiento == "control 0mm G"
  ) %>%
  
  mutate(
    tratamiento = "control"
  )


# Combinar control + tratamientos de TME

datos_TME_grafico <- bind_rows(
  control_base,
  datos_TME
)


# Calcular medias y errores estándar

datos_grafico_TME <- datos_TME_grafico %>%
  
  mutate(
    especie = factor(
      especie,
      levels = orden_especies
    )
  ) %>%
  
  group_by(
    especie,
    tratamiento
  ) %>%
  
  summarise(
    media = mean(TM),
    se = sd(TM) / sqrt(n()),
    .groups = "drop"
  ) %>%
  
  mutate(
    tipo = "TME"
  ) %>%
  
  # Incorporar las letras del modelo de TME.
  # El control queda sin letra porque no forma parte
  # del modelo estadístico de TME.
  
  left_join(
    letras_TME,
    by = c("especie", "tratamiento")
  ) %>%
  
  mutate(
    tratamiento = factor(
      tratamiento,
      levels = orden_tratamientos_grafico
    )
  )


# =========================================================
# UNIR TMG Y TME
# =========================================================

datos_grafico_TM <- bind_rows(
  datos_grafico_TMG,
  datos_grafico_TME
)


# Orden de los paneles

datos_grafico_TM <- datos_grafico_TM %>%
  
  mutate(
    tipo = factor(
      tipo,
      levels = c("TMG", "TME")
    )
  )


